#!/usr/bin/env zsh

ICON_FONT="JetBrainsMono Nerd Font"
LABEL_FONT="JetBrainsMono Nerd Font"
PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

source "$CONFIG_DIR/colors.sh"

# Detect if running on laptop (built-in display)
MAIN_DISPLAY=$(system_profiler SPDisplaysDataType | grep -B 3 'Main Display:' | awk '/Display Type/ {print $3}')
IS_LAPTOP=$([[ "$MAIN_DISPLAY" = "Built-in" ]] && echo 1 || echo 0)

sketchybar --bar \
    height=32 \
    color=$BAR_COLOR \
    border_width=2 \
    border_color=$BAR_BORDER_COLOR \
    shadow=off \
    margin=12 \
    y_offset=10 \
    corner_radius=9 \
    position=top \
    sticky=on \
    padding_left=10 \
    padding_right=10 \
    notch_width=188 \
    display=main

sketchybar --default \
    background.color=$BG_PRIMARY \
    background.corner_radius=0 \
    background.padding_right=4 \
    background.height=24 \
    background.shadow.drawing=off \
    icon.font="$ICON_FONT:Bold:15.0" \
    icon.color=$FG \
    icon.padding_left=6 \
    icon.padding_right=4 \
    label.font="$LABEL_FONT:SemiBold:14.0" \
    label.color=$FG \
    label.y_offset=0 \
    label.padding_left=0 \
    label.padding_right=6

##### Left #####
source "$ITEM_DIR/apple.sh"
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/front_app.sh"

##### Center #####
source "$ITEM_DIR/claude_agents.sh"

##### Right (add-order is rightmost-first → reverse of visual order) #####
source "$ITEM_DIR/clock.sh"
[[ $IS_LAPTOP -eq 1 ]] && source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/weather.sh"
source "$ITEM_DIR/brightness.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/wifi.sh"
source "$ITEM_DIR/memory.sh"
source "$ITEM_DIR/cpu.sh"
source "$ITEM_DIR/homebrew.sh"
source "$ITEM_DIR/pomodoro.sh"

##### Finalize #####
sketchybar --update
sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE=$(aerospace list-workspaces --focused 2>/dev/null)
